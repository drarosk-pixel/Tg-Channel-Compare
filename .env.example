# ---- Required for the multi-user bot (bot.py) ----

# From https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Control bot token from @BotFather. Users log in THROUGH this bot.
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyz

# Encrypts stored user sessions at rest. Generate once with: python gen_key.py
# Never change it later, or all stored logins become unreadable.
ENCRYPTION_KEY=

# Optional: restrict who can use the bot (comma-separated Telegram user IDs). Empty = everyone.
ALLOWED_USER_IDS=

# Where encrypted user sessions are stored
SESSIONS_DB_PATH=data/sessions.db

# How many latest messages to scan per channel. 0 = full history
DEFAULT_LIMIT=0

# Where reports are written
REPORTS_DIR=reports


# ---- Only for single-account mode (login.py / compare_cli.py / userbot.py) ----
# Not needed for the multi-user bot.
PHONE=
SESSION_STRING=
SESSION_NAME=sessions/userbot

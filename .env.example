# Get these from https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Optional: your phone number with country code (asked during login if empty)
PHONE=+911234567890

# For hosting: string printed by `python login.py`. When set, the session file below is not used.
SESSION_STRING=

# Session file path (no extension). Keep this file private, it gives full access to your account.
SESSION_NAME=sessions/userbot

# How many latest messages to scan per channel. 0 = full history
DEFAULT_LIMIT=0

# Where reports are written
REPORTS_DIR=reports
